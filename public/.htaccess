# Apache/LiteSpeed (SEOHOST). Strona jest w pełni prerenderowana — każda trasa ma
# swój plik dist/<trasa>/index.html, więc NIE przepisujemy wszystkiego na index.html.
# Nieistniejące adresy zwracają prawdziwy status 404 (fix soft-404 z audytu SEO).

# Statyczna strona błędu (generowana przez prerender jako dist/404.html)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Kanoniczny host: https + bez www, jednym skokiem 301 ---
  # (http i www serwowały dotąd własne kopie strony — duplikaty dla Google)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- 301: stare adresy z poprzedniej wersji strony (wiszą w indeksie Google) ---
  RewriteRule ^projekty/?$ /uslugi [R=301,L]
  RewriteRule ^kolejne-uslugi-dostepne/?$ /uslugi [R=301,L]

  # --- Kanonicznie BEZ końcowego slasha (sitemapa, canonicale i linki są bez) ---
  # Bez tych reguł mod_dir robił 301 /kontakt -> /kontakt/, przez co każdy adres
  # z sitemapy kosztował Googlebota 2 żądania (drugie często kończyło się 429
  # od limitera SEOHOST -> "błąd przekierowania" w GSC), a strona pod /kontakt/
  # deklarowała canonical /kontakt, który przekierowywał z powrotem — błędne koło.

  # a) wersję ze slashem przekieruj na kanoniczną bez slasha
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # b) adres bez slasha serwuj wprost z prerenderu — status 200, zero przekierowań
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # --- Istniejące pliki i katalogi (prerender, assety) serwuj normalnie ---
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --- SPA fallback TYLKO dla treści dynamicznych (status 200 jest tu zamierzony) ---
  # /admin — panel CMS; /blog/* — wpisy dodane w CMS po ostatnim buildzie
  RewriteRule ^admin(/.*)?$ index.html [L]
  RewriteRule ^blog/.+$ index.html [L]

  # Cała reszta: brak pliku → Apache zwraca 404 + /404.html (ErrorDocument wyżej)
</IfModule>

# Lekki cache dla zasobów z hashem w nazwie (Vite hashuje pliki w /assets)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML (w tym prerenderowane podstrony) NIGDY nie może być cache'owany długo —
  # inaczej po wdrożeniu przeglądarki trzymają stare strony wskazujące na stare
  # pliki JS i użytkownicy widzą nieaktualną wersję (albo błędy).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Zasoby z hashem w nazwie — rok + immutable
  <FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
